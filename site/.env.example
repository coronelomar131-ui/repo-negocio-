# Variables para Vercel (Settings → Environment Variables). NO subas valores reales al repo.
# Llave privada de Mercado Pago (Tu negocio → Credenciales de producción → Access Token, empieza con APP_USR-)
MP_ACCESS_TOKEN=
# Clave secreta de los avisos (Webhooks → Configurar notificaciones → Clave secreta)
MP_WEBHOOK_SECRET=
# Dirección pública de la página, sin diagonal al final
NEXT_PUBLIC_SITIO_URL=https://tu-pagina.vercel.app
